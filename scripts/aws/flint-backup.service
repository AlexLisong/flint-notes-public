[Unit]
Description=Flint SQLite and immutable attachment backup to S3
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/flint/current/scripts/aws/backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/flint /etc/flint
ReadWritePaths=/var/backups/flint
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=30min
MemoryMax=512M
