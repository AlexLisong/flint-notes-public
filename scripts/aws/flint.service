[Unit]
Description=Flint encrypted notes and publishing
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flint
Group=flint
WorkingDirectory=/opt/flint/current
EnvironmentFile=/etc/flint/runtime.env
ExecStart=/usr/bin/node dist-server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/flint
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
