{
  "name": "flint-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs && esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-server/index.js && esbuild bridge/cli.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-bridge/cli.js",
    "start": "node dist-server/index.js",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bridge": "tsx bridge/cli.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/view": "^6.38.6",
    "@codemirror/state": "^6.5.2",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.3",
    "@uiw/react-codemirror": "^4.25.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.468.0",
    "idb": "^8.0.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.1",
    "katex": "^0.16.22",
    "fflate": "^0.8.2",
    "zod": "^4.1.11",
    "diff": "^8.0.2",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/node": "^22.18.6",
    "@types/express": "^5.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/diff": "^7.0.2",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "tsx": "^4.20.6",
    "esbuild": "^0.25.10",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3"
  },
  "license": "MIT"
}
